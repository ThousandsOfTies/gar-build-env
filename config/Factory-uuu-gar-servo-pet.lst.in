uuu_version @@UUU_VERSION@@

# UUU command-list files must start with the version declaration.
# Generated for GarServoPet / NXP FRDM-IMX91S.
#
# This is intentionally a component flow.  It boots the NXP manufacturing
# initramfs with U-Boot fastboot (FB:), waits for the Linux fastboot-kernel
# endpoint (FBK:), partitions the target, and writes each component.
#
# Do not copy partition numbers from another product.  The generator keeps
# this file behind GAR_IMX91S_LAYOUT_CONFIRMED for that reason.
# i.MX91 is an SDPS ROM device with current UUU releases.
SDPS[-t 10000]: boot -scanterm -f pub/u-boot/flash_gar_servo_pet.bin -scanlimited 0x800000

# Load the manufacturing Linux kernel, DTB, and initramfs through U-Boot.
# Use chunked FB: write commands instead of FB: download: older UUU releases
# use a fixed short libusb timeout in FBDownload, while FB: write honors the
# per-command timeout. Transfer-only copies are zero-padded to the chunk
# boundary because the observed WSL/U-Boot Fastboot path deterministically
# stalls on the final short chunk. The original byte sizes below remain
# available for diagnostics; the legacy ramdisk header remains authoritative.
#
# Each chunk is copied from the fastboot staging buffer into the final boot
# address. @off is a byte offset supplied by FB: write; setexpr turns it into
# the destination address before cp.b runs.
FB: ucmd setenv gar_kernel_addr ${loadaddr}
FB: ucmd setenv fastboot_buffer @@FASTBOOT_BUFFER@@
FB[-t @@TRANSFER_TIMEOUT_MS@@]: write -f @@KERNEL_TRANSFER@@ -format "setexpr gar_copy_dst ${loadaddr} + @off; cp.b ${fastboot_buffer} ${gar_copy_dst} @size" -blksz 1 -each @@TRANSFER_CHUNK_SIZE@@
FB: ucmd setenv gar_kernel_size @@KERNEL_SIZE@@

FB: ucmd setenv gar_dtb_addr ${fdt_addr_r}
FB: ucmd setenv fastboot_buffer @@FASTBOOT_BUFFER@@
FB[-t @@TRANSFER_TIMEOUT_MS@@]: write -f @@DTB_TRANSFER@@ -format "setexpr gar_copy_dst ${fdt_addr_r} + @off; cp.b ${fastboot_buffer} ${gar_copy_dst} @size" -blksz 1 -each @@TRANSFER_CHUNK_SIZE@@
FB: ucmd setenv gar_dtb_size @@DTB_SIZE@@

FB: ucmd setenv gar_initrd_addr ${initrd_addr}
FB: ucmd setenv fastboot_buffer @@FASTBOOT_BUFFER@@
FB[-t @@TRANSFER_TIMEOUT_MS@@]: write -f @@INITRD_TRANSFER@@ -format "setexpr gar_copy_dst ${initrd_addr} + @off; cp.b ${fastboot_buffer} ${gar_copy_dst} @size" -blksz 1 -each @@TRANSFER_CHUNK_SIZE@@
FB: ucmd setenv gar_initrd_size @@INITRD_SIZE@@
# Follow bootcmd_mfg: set rdinit=/linuxrc, validate the legacy U-Boot ramdisk,
# and pass its address (without :size) to booti.
FB: ucmd run mfgtool_args
FB: ucmd iminfo ${gar_initrd_addr}
# Fastboot ACmd has a short command-length limit. Store the full command via
# UCmd, then asynchronously execute only the short environment-variable name.
FB: ucmd setenv gar_bootcmd booti ${gar_kernel_addr} ${gar_initrd_addr} ${gar_dtb_addr}
FB: acmd run gar_bootcmd

# The initramfs must provide the NXP imx-uuc/linuxrc endpoint.  All following
# commands run in that Linux environment, not in U-Boot.
FBK: ucmd udevadm settle || true
FBK: ucp pub/layout/gar-servo-pet.sfdisk t:/tmp/gar-servo-pet.sfdisk
FBK: ucmd sfdisk --force @@DISK@@ < /tmp/gar-servo-pet.sfdisk
FBK: ucmd partprobe @@DISK@@ || true

FBK: ucmd mkfs.vfat -F 32 @@DISK@@p@@BOOT_PART@@
FBK: ucmd mkfs.ext4 -F @@DISK@@p@@OVERLAY_PART@@
FBK: ucmd mkfs.ext4 -F @@DISK@@p@@STORAGE_PART@@

# Install the boot files used by the normal U-Boot distro boot path.
FBK: ucmd mkdir -p /mnt/gar-boot/extlinux
FBK: ucmd mount @@DISK@@p@@BOOT_PART@@ /mnt/gar-boot
FBK: ucp pub/kernel/Image t:/mnt/gar-boot/Image
FBK: ucp pub/kernel/@@DTB@@ t:/mnt/gar-boot/@@DTB@@
FBK: ucp pub/kernel/extlinux.conf t:/mnt/gar-boot/extlinux/extlinux.conf
FBK: ucmd sync
FBK: ucmd umount /mnt/gar-boot

# Write the immutable root and then seed the writable overlay and storage.
FBK: ucp pub/rootfs/rootfs.squashfs t:/tmp/gar-rootfs.squashfs
FBK: ucmd dd if=/tmp/gar-rootfs.squashfs of=@@DISK@@p@@ROOTFS_PART@@ bs=4M conv=fsync
FBK: ucmd mkdir -p /mnt/gar-overlay /mnt/gar-storage
FBK: ucmd mount @@DISK@@p@@OVERLAY_PART@@ /mnt/gar-overlay
FBK: ucp pub/rootfs/usr.local.tar.bz2 t:/tmp/usr.local.tar.bz2
FBK: ucmd tar -xjf /tmp/usr.local.tar.bz2 -C /mnt/gar-overlay
FBK: ucmd sync
FBK: ucmd umount /mnt/gar-overlay
FBK: ucmd mount @@DISK@@p@@STORAGE_PART@@ /mnt/gar-storage
FBK: ucmd mkdir -p /mnt/gar-storage/gar-servo-pet
FBK: ucmd sync
FBK: ucmd umount /mnt/gar-storage
FBK: acmd reboot

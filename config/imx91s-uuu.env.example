# Copy to config/imx91s-uuu.env.  This file describes the Product-owned UUU
# script, not the NXP BSP build itself.  Keep the copied file local unless the
# values are intentionally part of the Product configuration.

# UUU 1.5.x understands MX91 as an SDPS device.  The old product script used
# an older uuu_version and an FBK: download command which current UUU rejects.
export GAR_UUU_VERSION=1.5.243

# Per-USB-bulk-operation timeout in milliseconds.  WSL2/usbipd can need more
# than UUU's 2-second default for a 1 MiB transfer chunk.
export GAR_UUU_TRANSFER_TIMEOUT_MS=30000

# NXP FRDM-IMX91S LPDDR4 machine values from the public BSP.
export GAR_IMX91S_DTB=imx91-11x11-frdm-imx91s.dtb

# The board's on-board eMMC is normally Linux mmcblk0.  Confirm this through
# the manufacturing initramfs before changing the value or enabling writes.
export GAR_IMX91S_DISK=/dev/mmcblk0
export GAR_IMX91S_BOOT_PART=1
export GAR_IMX91S_ROOTFS_PART=2
export GAR_IMX91S_OVERLAY_PART=3
export GAR_IMX91S_STORAGE_PART=4

# Relative to the UUU bundle root.  The file is supplied as a deploy.uuu
# component and is applied by sfdisk in the manufacturing initramfs.
export GAR_IMX91S_LAYOUT_FILE=pub/layout/gar-servo-pet.sfdisk

# Safety gate.  Leave 0 while iterating or doing -dry validation.  Set to 1
# only after the partition starts/sizes, eMMC device number, and boot files have
# been verified on the actual FRDM-IMX91S board.
export GAR_IMX91S_LAYOUT_CONFIRMED=0

# Optional paths used by the helper scripts.
# export GAR_UUU_BIN=/home/user/.local/bin/uuu
# export GAR_IMX91S_TEMPLATE=config/Factory-uuu-gar-servo-pet.lst.in
# export GAR_IMX91S_OUTPUT=artifacts/from-codespace

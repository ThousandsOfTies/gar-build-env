# shellcheck shell=bash
# Deprecated compatibility entrypoint.
# New setups should copy config/frdm-imx91s.env.example to
# config/frdm-imx91s.env. Existing scripts that source this file continue to
# receive the canonical FRDM-IMX91S defaults.

gar_config_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "${gar_config_dir}/frdm-imx91s.env.example"
unset gar_config_dir

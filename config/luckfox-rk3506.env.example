# Copy to config/luckfox-rk3506.env only when the SDK is not in the default
# sibling workspace location. The Product package uses Luckfox's official
# arm-none-linux-gnueabihf GCC and the matching Buildroot target runtime.

export GAR_LUCKFOX_TRIPLE=arm-none-linux-gnueabihf

# Luckfox Lyra SDK root. If omitted, the package script also checks
# ../LuckFox/luckfox-lyra-sdk-250815 relative to this Product repository.
# export GAR_LUCKFOX_SDK_ROOT=/path/to/luckfox-lyra-sdk-250815

# These may be set directly when the SDK has a different layout.
# export GAR_LUCKFOX_TOOLCHAIN_BIN=/path/to/toolchain/bin
# export GAR_LUCKFOX_RUNTIME_ROOT=/path/to/buildroot/target
